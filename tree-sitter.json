{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mlua",
      "scope": "source.mlua",
      "path": ".",
      "file-types": [
        "mlua",
        "d.mlua"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^mlua$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
      {
        "name": "taerim0",
        "url": "https://github.com/taerim0"
      },
      {
        "name": "Munif Tanjim",
        "email": "hello@muniftanjim.dev",
        "url": "https://muniftanjim.dev"
      }
    ],
    "links": {
      "repository": "https://github.com/taerim0/tree-sitter-mlua"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
